<%- include("partials/header") %>

    <div class="container py-5">
        <div class="text-center mb-5">
            <h1>Project Inquiry & Requirements</h1>
            <p class="mt-3 text-secondary">
                Tell me about your project, requirements, budget, and timeline.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <form action="https://api.web3forms.com/submit" method="POST">
                            <input type="hidden" name="access_key" value="5ca1571e-2815-41a5-b320-7aada5da688a">
                            <input type="hidden" name="subject" value="New Portfolio Project Inquiry">
                            <input type="hidden" name="from_name" value="Portfolio Inquiry Form">

                            <div class="mb-3">
                                <label for="name" class="form-label">Full Name *</label>
                                <input id="name" type="text" name="name" class="form-control" placeholder="Your name"
                                    required>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address *</label>
                                <input id="email" type="email" name="email" class="form-control"
                                    placeholder="you@example.com" required>
                            </div>

                            <div class="mb-3">
                                <label for="phone" class="form-label">WhatsApp / Phone</label>
                                <input id="phone" type="tel" name="phone" class="form-control"
                                    placeholder="Your contact number">
                            </div>

                            <div class="mb-3">
                                <label for="company" class="form-label">Company / Business</label>
                                <input id="company" type="text" name="company" class="form-control"
                                    placeholder="Business name or website">
                            </div>

                            <div class="mb-3">
                                <label for="project_type" class="form-label">Project Type *</label>
                                <select id="project_type" name="project_type" class="form-select" required>
                                    <option value="">Choose a project type</option>
                                    <option>Website / Landing Page</option>
                                    <option>Web Application</option>
                                    <option>Backend / API Development</option>
                                    <option>Automation / Scripts</option>
                                    <option>AI / API Integration</option>
                                    <option>Bug Fixes / Maintenance</option>
                                    <option>Other</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="requirements" class="form-label">Project Requirements *</label>
                                <textarea id="requirements" name="requirements" class="form-control" rows="5"
                                    placeholder="Describe your goals, required features, and any reference websites..."
                                    required></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="budget" class="form-label">Estimated Budget</label>
                                <select id="budget" name="budget" class="form-select">
                                    <option value="">Select a budget (optional)</option>
                                    <option>Under ₹10,000</option>
                                    <option>₹10,000–₹25,000</option>
                                    <option>₹25,000–₹50,000</option>
                                    <option>₹50,000+</option>
                                    <option>International / USD budget</option>
                                    <option>Not decided yet</option>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label for="timeline" class="form-label">Expected Timeline</label>
                                <select id="timeline" name="timeline" class="form-select">
                                    <option value="">Select a timeline (optional)</option>
                                    <option>As soon as possible</option>
                                    <option>Within 2–4 weeks</option>
                                    <option>Within 1–3 months</option>
                                    <option>Flexible / To be discussed</option>
                                </select>
                            </div>

                            <div class="d-none" aria-hidden="true">
                                <label>Leave this field empty</label>
                                <input type="checkbox" name="botcheck" tabindex="-1">
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                Submit Project Inquiry
                            </button>

                            <p class="small text-secondary text-center mt-3 mb-0">
                                Your project details will be sent securely to my inquiry email.
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Existing contact options retained -->
    <div class="container pb-5 text-center">
        <h2 class="h4">Prefer to contact me directly?</h2>
        <p class="mt-3">
            Feel free to reach out for projects or collaboration.
        </p>

        <div class="contact-links mt-4">
            <p><b>Email:</b> mohitkaushinit@gmail.com</p>

            <p>
                <a href="https://wa.me/917015505745" class="btn btn-success m-2" target="_blank"
                    rel="noopener noreferrer">WhatsApp</a>

                <a href="https://www.upwork.com/freelancers/~011b8b35a7b209687b?mp_source=share"
                    class="btn btn-primary m-2" target="_blank" rel="noopener noreferrer">Upwork</a>

                <a href="https://www.fiverr.com/s/qD1oV22" class="btn btn-dark m-2" target="_blank"
                    rel="noopener noreferrer">Fiverr</a>
            </p>
        </div>
    </div>

    <%- include("partials/footer") %>